{
  "$schema": "./node_modules/fallow/schema.json",
  "duplicates": {
    "minOccurrences": 3,
    "threshold": 3.0
  },
  "entry": [
    "src/db/test-worker.ts",
    "src/db/index.ts",
    "src/db/schema.ts",
    "src/lib/auth.ts",
    "src/env.ts",
    "src/db/seed/seed-*.ts"
  ],
  "framework": [
    {
      "detection": {
        "package": "@tanstack/react-start",
        "type": "dependency"
      },
      "name": "tanstack-start-server-fns",
      "usedExports": [
        {
          "exports": [
            "*"
          ],
          "pattern": "src/db/queries/*.queries.ts"
        },
        {
          "exports": [
            "*"
          ],
          "pattern": "src/features/**/functions.ts"
        }
      ]
    }
  ],
  "health": {
    "ignore": [
      "src/components/ui/**"
    ]
  },
  "ignoreDependencies": [
    "@faker-js/faker",
    "@fontsource-variable/noto-sans",
    "@tanstack/ai-client",
    "@tanstack/match-sorter-utils",
    "@tanstack/store",
    "nitro",
    "@tailwindcss/typography",
    "@shadcn/lint"
  ],
  // Keep shadcn in analysis (so deps stay tracked), only silence the
  // exports + health noise on it.
  "ignoreExports": [
    {
      "exports": [
        "*"
      ],
      "file": "src/components/ui/**"
    }
  ],
  "rules": {
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn"
  },
  "supportEntry": [
    "src/features/transcription/**/*.{ts,tsx}",
    "scripts/oxlint-ui-plugin.mjs",
    "src/routes/_auth/app/playground/**",
    "src/hooks/**",
    "public/models/**",
    "scripts/migrate-zod-uuid.ts",
    "scripts/setup-organization.ts",
    "drizzle.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "usedClassMembers": [
    {
      "implements": "ApiProvider",
      "members": [
        "id",
        "callApi"
      ]
    }
  ]
}
